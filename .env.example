SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.name@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

NAVER_CLIENT_ID=
